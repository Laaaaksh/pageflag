# Copy to .env and fill in. Used by `docker compose up` and by the server directly
# when run outside Docker (`npm run dev:server`).

# Postgres connection string. The docker-compose Postgres service matches this by default.
DATABASE_URL=postgres://pageflag:pageflag@localhost:5432/pageflag

# Any long random string - signs session cookies. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-at-least-16-characters

# Port the API server listens on.
PORT=4000

# Where uploaded pin screenshots are stored on disk.
SCREENSHOT_DIR=./data/screenshots

# The dashboard's own origin, for CORS on authenticated (cookie-based) API routes.
# Not needed for the widget's public API, which accepts requests from any origin the
# project's per-site domain allow-list permits.
DASHBOARD_ORIGIN=http://localhost:5173
