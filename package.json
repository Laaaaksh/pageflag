{
  "name": "pageflag",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/widget",
    "server",
    "dashboard"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/widget && npm run build --workspace dashboard && npm run build --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:dashboard": "npm run dev --workspace dashboard",
    "dev:widget": "npm run dev --workspace packages/widget",
    "test": "npm run test --workspace packages/widget && npm run test --workspace dashboard && npm run test --workspace server",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "migrate": "npm run migrate --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^10.9.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
